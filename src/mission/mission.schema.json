{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier-fly.dev/schemas/mission/v1.json",
  "title": "FrontierFlyMission",
  "description": "Civilian search-and-rescue or safety-inspection mission. Coordinates are local meters, x east and y north.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "seed",
    "notes",
    "geofence",
    "noFlyZones",
    "altitude",
    "missionType",
    "targets",
    "requiredConfidence",
    "entryPolicy",
    "budgets",
    "startPose"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "notes": { "type": "string", "maxLength": 500 },
    "geofence": { "$ref": "#/$defs/polygon" },
    "noFlyZones": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/noFlyZone" }
    },
    "altitude": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minM", "maxM"],
      "properties": {
        "minM": { "type": "number", "minimum": 0, "maximum": 120 },
        "maxM": { "type": "number", "minimum": 0, "maximum": 120 }
      }
    },
    "missionType": {
      "type": "string",
      "enum": ["find_objects", "find_person", "safety_sweep", "building_inspection", "composite"]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/target" }
    },
    "requiredConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "entryPolicy": { "type": "string", "enum": ["auto", "ask", "never"] },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batteryPct", "timeSec"],
      "properties": {
        "batteryPct": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "timeSec": { "type": "integer", "minimum": 30, "maximum": 7200 }
      }
    },
    "startPose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z", "yawRad"],
      "properties": {
        "x": { "type": "number", "minimum": -50000, "maximum": 50000 },
        "y": { "type": "number", "minimum": -50000, "maximum": 50000 },
        "z": { "type": "number", "minimum": 0, "maximum": 120 },
        "yawRad": { "type": "number", "minimum": -6.28318530718, "maximum": 6.28318530718 }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": -50000, "maximum": 50000 },
        "y": { "type": "number", "minimum": -50000, "maximum": 50000 }
      }
    },
    "polygon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points"],
      "properties": {
        "points": {
          "type": "array",
          "minItems": 3,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/point" }
        }
      }
    },
    "noFlyZone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "polygon", "reason"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "polygon": { "$ref": "#/$defs/polygon" },
        "reason": { "type": "string", "maxLength": 160 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "minCount", "minConfidence"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "kind": {
          "type": "string",
          "enum": ["object", "person", "hazard", "structure", "clearance"]
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "minCount": { "type": "integer", "minimum": 1, "maximum": 50 },
        "minConfidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    }
  }
}
