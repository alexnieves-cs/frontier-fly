{
  "name": "frontier-fly",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Watch a tiny neural network learn to fly through procedural buildings, entirely in the browser.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretrain": "vitest run tests/unit/pretrain.test.ts",
    "eval:coverage": "vite-node scripts/eval-coverage.ts --",
    "train:dagger": "vite-node scripts/train-dagger.ts --"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.14.0",
    "@tensorflow/tfjs": "4.22.0",
    "three": "0.170.0",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.49.1",
    "@types/three": "^0.170.0",
    "eslint": "9.17.0",
    "typescript": "5.7.2",
    "typescript-eslint": "8.19.0",
    "vite": "6.0.6",
    "vitest": "2.1.8"
  }
}
