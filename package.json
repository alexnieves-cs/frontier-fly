{
  "name": "frontier-fly",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A search-and-rescue drone autopilot, learned by imitation from a privileged teacher and fine-tuned with PPO, that searches buildings from the treeline to the last room, entirely in the browser.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "COVERAGE=1 vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretrain": "vitest run tests/unit/pretrain.test.ts",
    "bench": "vitest run --config vitest.bench.config.ts",
    "docs": "node scripts/docs/generate.mjs",
    "docs:check": "node scripts/docs/generate.mjs --check",
    "media": "node scripts/media/record.mjs",
    "media:film": "node scripts/media/film.mjs",
    "media:social": "node scripts/media/social-preview.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "pack:checkpoint": "vite-node scripts/pack-checkpoint.ts --",
    "pack:policy": "vite-node scripts/pack-policy.ts",
    "eval:coverage": "vite-node scripts/eval-coverage.ts --",
    "train:dagger": "vite-node scripts/train-dagger.ts --",
    "train:indoor": "vite-node scripts/train-indoor.ts --",
    "train:ppo": "vite-node scripts/train-ppo.ts --",
    "study:coverage": "node scripts/study/parallel.mjs coverage-study docs/study.json",
    "study:missions": "node scripts/study/parallel.mjs mission-study docs/mission-bench.json",
    "study:sar": "node scripts/study/parallel.mjs sar-study docs/sar-bench.json",
    "study:faults": "node scripts/study/parallel.mjs fault-study docs/fault-bench.json",
    "study:speed": "node scripts/study/parallel.mjs speed-study docs/speed-study.json",
    "study:team": "node scripts/study/parallel.mjs team-study docs/team-bench.json",
    "study:plans": "node scripts/study/parallel.mjs plans-study docs/plans-bench.json",
    "bench:score": "vite-node scripts/bench/score.ts",
    "bench:board": "vite-node scripts/bench/board.ts",
    "bench:verify": "vite-node scripts/bench/verify.ts",
    "bench:team": "vite-node scripts/bench/team.ts",
    "study:vision": "node scripts/study/parallel.mjs vision-study docs/vision-bench.json",
    "study:loc": "node scripts/study/parallel.mjs loc-study docs/localization.json",
    "study:intel": "vite-node scripts/study/intel-lab.ts -- --out docs/intel-lab.json",
    "report:pdf": "node scripts/docs/report-pdf.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.14.0",
    "@tensorflow/tfjs": "4.22.0",
    "three": "0.170.0",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/three": "^0.170.0",
    "@vitest/coverage-v8": "4.1.12",
    "ajv": "8.20.0",
    "eslint": "9.39.5",
    "globals": "14.0.0",
    "typescript": "5.7.2",
    "typescript-eslint": "8.72.0",
    "vite": "6.4.5",
    "vite-node": "3.2.4",
    "vitest": "5.0.5"
  }
}
